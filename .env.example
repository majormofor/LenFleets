# Server-only values. Never prefix delivery credentials with VITE_.
RESEND_API_KEY=
CONTACT_FROM_EMAIL=
CONTACT_TO_EMAIL=info@lensfleet.com
# Origin allowed to post enquiries. Set this to your confirmed deployed origin.
SITE_ORIGIN=http://127.0.0.1:5173
# Build-time canonical origin. Leave empty until the production domain is confirmed.
PUBLIC_SITE_URL=
PORT=4173
HOST=127.0.0.1
