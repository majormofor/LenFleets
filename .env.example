# Server-only values. Never prefix delivery credentials with VITE_.
RESEND_API_KEY=
CONTACT_FROM_EMAIL=
CONTACT_TO_EMAIL=info@lensfleet.com
# Origin allowed to post enquiries. Set this to your confirmed deployed origin.
SITE_ORIGIN=http://127.0.0.1:5173
# Build-time canonical origin. Set this to the domain the site is actually
# served from, or canonical tags and sitemap.xml will point at the wrong host.
# Static hosting example: PUBLIC_SITE_URL=https://lensfleet.com
PUBLIC_SITE_URL=
# Only needed when the built site is hosted somewhere that cannot run Node, for
# example Hostinger shared hosting. Point it at a deployment that does run the
# API, and set SITE_ORIGIN there to this site's origin so the post is accepted.
# Example: VITE_CONTACT_ENDPOINT=https://lensfleet-website.onrender.com/api/contact
VITE_CONTACT_ENDPOINT=
PORT=4173
HOST=127.0.0.1
