# Apache configuration for static hosting (Hostinger shared hosting and similar).
# The Node server in server/index.mjs sets these headers itself, so this file is
# only read when the built site is served by Apache. It is copied into dist/ by
# Vite on every build.

# Every route is prerendered as its own folder with an index.html, so no rewrite
# rules are needed for clean URLs. Only the not-found page has to be wired up.
ErrorDocument 404 /404.html

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "DENY"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"

  # Filenames under /assets carry a content hash, so they can never go stale.
  <FilesMatch "\.(js|css)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # Fonts and imagery are not hashed but do not change between deploys. Without
  # this they are revalidated on every fresh page load, which is roughly 75KB a
  # visit on metered mobile data.
  <FilesMatch "\.(woff2|avif|webp|jpg|jpeg|png|svg|ico)$">
    Header set Cache-Control "public, max-age=2592000, stale-while-revalidate=86400"
  </FilesMatch>

  # HTML and the manifest must revalidate so a new upload is picked up at once.
  <FilesMatch "\.(html|webmanifest|xml|txt)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/javascript application/json application/manifest+json image/svg+xml
</IfModule>

<IfModule mod_mime.c>
  AddType font/woff2 .woff2
  AddType image/avif .avif
  AddType image/webp .webp
  AddType application/manifest+json .webmanifest
</IfModule>

# Serve pre-compressed files if they are ever generated alongside the originals.
<IfModule mod_deflate.c>
  <IfModule mod_headers.c>
    <FilesMatch "\.(js|css|svg|json|xml)$">
      Header append Vary Accept-Encoding
    </FilesMatch>
  </IfModule>
</IfModule>
