{
  "name": "lensfleet",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "prebuild": "node scripts/ensure-build-dependencies.mjs",
    "build": "tsc -b && vite build && node scripts/prerender.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test scripts/contact.test.mjs",
    "start": "node --env-file-if-exists=.env server/index.mjs",
    "check": "npm run build && node scripts/check-site.mjs && npm test"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "lucide-react": "^0.468.0"
  },
  "devDependencies": {
    "typescript": "~5.7.2",
    "vite": "^6.0.5",
    "@vitejs/plugin-react": "^4.3.4",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "esbuild": "0.25.12"
  }
}
